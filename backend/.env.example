# Copy this file to .env and fill in your own values. Never commit .env.

# --- Primary LLM: Google Gemini (free key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Backup Gemini keys, comma-separated: used one after another when a key's quota runs out or it is rejected.
GEMINI_API_KEYS=
# Models used to write answers, in fallback order (an overloaded model is skipped).
GEMINI_MODEL=gemini-2.5-flash,gemini-3.6-flash,gemini-flash-latest
# Cheaper models used for query planning and claim verification, in fallback order.
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest

# --- Optional fallback LLM: any OpenAI-compatible endpoint (Groq, OpenRouter, OpenAI) ---
# Used automatically if Gemini is rate-limited or unavailable.
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=llama-3.3-70b-versatile

# Seconds to wait for one LLM response, and the longest rate-limit back-off to sit
# through before switching to the fallback provider (if one is configured).
LLM_TIMEOUT=90
LLM_MAX_WAIT=20

# --- Source document ---
PDF_PATH=data/raw/income-tax-act-1961-as-amended-by-finance-act-2026.pdf
SOURCE_NAME=Income-tax Act, 1961 (as amended by Finance Act, 2026)
SOURCE_EDITION=As amended by the Finance Act, 2026 - CBDT consolidated text, incometaxindia.gov.in

# --- Retrieval (defaults run fully on CPU, no GPU needed) ---
# Embeddings: "local" (ONNX on CPU, models downloaded once to backend/.models) or "gemini" (gemini-embedding-001 via API)
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# Minimum reranker relevance (0-1) for the best passage before the system abstains.
MIN_RELEVANCE=0.10
# Candidates per search (BM25 / dense) and passages given to the LLM.
BM25_TOP_K=30
DENSE_TOP_K=30
CONTEXT_K=10
# Cross-encoder cost controls (CPU): candidates per sub-question, total (question, passage)
# pairs per question, and passage length in characters. Lower = faster, higher = more recall.
RERANK_POOL=16
RERANK_BUDGET=72
RERANK_MAX_CHARS=1100

# --- Runtime ---
# Load the index and models in the background when the API starts (1) or on the first question (0).
WARMUP=1
